{
  "name": "sveltekit-postgres-starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "docs:api": "typedoc --plugin typedoc-plugin-markdown --entryPointStrategy expand --entryPoints src/lib/server --out docs/api --skipErrorChecking --readme none --hideBreadcrumbs --disableSources --sort alphabetical --validation.notDocumented true",
    "docs:api:check": "npm run docs:api && git diff --exit-code docs/api"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/pg": "^8.11.11",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.10",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "tsx": "^4.19.2",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.6.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.6"
  }
}
