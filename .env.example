# ── Postgres ──────────────────────────────────────────────────────────────────
# Primary application database. Any Postgres provider works (Neon, Railway,
# Supabase-direct, self-hosted via docker-compose.yml…).
DATABASE_URL=postgres://verdantstack:verdantstack@localhost:5433/verdantstack

# Used by the test suite (vitest). Point it at a disposable database; each
# test run truncates the tracked tables. Separating it from DATABASE_URL keeps
# your dev data safe. Matches the `test-db` service in docker-compose.yml.
TEST_DATABASE_URL=postgres://verdantstack:verdantstack@localhost:5434/verdantstack_test

# ── Connection pool (postgres.js / PgBouncer) ────────────────────────────────
# Max pooled client connections.
PG_MAX_CONNECTIONS=20
# Max time (s) an idle connection stays open.
PG_IDLE_TIMEOUT=20
# Connection timeout (s).
PG_CONNECT_TIMEOUT=10

# ── App behaviour ─────────────────────────────────────────────────────────────
# Seat limit while on MockBilling.
MOCK_PLAN_SEATS=3
# Failed attempts allowed per auth window.
AUTH_FAILED_ATTEMPTS=5
# Sliding auth window in ms (default 15 min).
AUTH_WINDOW_MS=900000
